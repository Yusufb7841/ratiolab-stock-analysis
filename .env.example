# Copy this file to .env and fill in your own values. Never commit .env.
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Required by SEC EDGAR: who is making the requests (name and a contact email you use).
SEC_USER_AGENT=YourProjectName your.email@example.com
